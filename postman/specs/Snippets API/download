      - category
    parameters:
    - name: id
      in: path
      description: A unique integer value identifying this category.
      required: true
      type: integer
  /post/:
    get:
      operationId: post_list
      description: ''
      parameters:
      - name: category__in
        in: query
        description: ''
        required: false
        type: string
      - name: category
        in: query
        description: ''
        required: false
        type: string
      - name: author
        in: query
        description: ''
        required: false
        type: string
      - name: status
        in: query
        description: ''
        required: false
        type: string
      - name: search
        in: query
        description: A search term.
        required: false
        type: string
      - name: ordering
        in: query
        description: Which field to use when ordering the results.
        required: false
        type: string
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      responses:
        '200':
          description: ''
          schema:
            required:
            - count
            - results
            type: object
            properties:
              count:
                type: integer
              next:
                type: string
                format: uri
                x-nullable: true
              previous:
                type: string
                format: uri
                x-nullable: true
              results:
                type: array
                items:
                  $ref: '#/definitions/Post'
      tags:
      - post
