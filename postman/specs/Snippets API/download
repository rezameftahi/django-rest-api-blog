      - post
    delete:
      operationId: post_delete
      description: ''
      parameters: []
      responses:
        '204':
          description: ''
      tags:
      - post
    parameters:
    - name: id
      in: path
      description: A unique integer value identifying this post.
      required: true
      type: integer
definitions:
  Category:
    required:
    - name
    type: object
    properties:
      id:
        title: ID
        type: integer
        readOnly: true
      name:
        title: Name
        type: string
        maxLength: 250
        minLength: 1
  Post:
    required:
    - title
    - content
    - category
    - published_date
    - status
    type: object
    properties:
      id:
        title: ID
        type: integer
        readOnly: true
      title:
        title: Title
        type: string
        maxLength: 250
        minLength: 1
      author:
        title: Author
        type: integer
        readOnly: true
      snippet:
        title: Snippet
        type: string
        readOnly: true
      image:
        title: Image
        type: string
        readOnly: true
        x-nullable: true
        format: uri
      content:
        title: Content
        type: string
        minLength: 1
      category:
        title: Category
        type: string
      relative_url:
        title: Relative url
        type: string
        format: uri
        readOnly: true
        minLength: 1
      absolute_url:
        title: Absolute url
        type: string
        readOnly: true
      published_date:
        title: Published date
        type: string
        format: date-time
      status:
        title: Status
        type: boolean
