  /blog/api/v1/post/:
    get:
      operationId: blog_api_v1_post_list
      description: ''
      parameters:
      - name: category__in
        in: query
        description: ''
        required: false
        type: string
      - name: category
        in: query
        description: ''
        required: false
        type: string
      - name: author
        in: query
        description: ''
        required: false
